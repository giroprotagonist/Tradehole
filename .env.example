# E*TRADE developer credentials (sandbox or production)
# Get keys at: https://developer.etrade.com/
ETRADE_CONSUMER_KEY=your_consumer_key_here
ETRADE_CONSUMER_SECRET=your_consumer_secret_here

# sandbox | production
ETRADE_ENV=sandbox

# Allow preview/place of option orders (set false to lock trading)
ETRADE_ENABLE_TRADING=true

# Local API (avoid :3000 — often already in use)
PORT=3169

# IRONSIGHT (optional sibling clone; also avoid :3000)
IRONSIGHT_URL=http://localhost:3170
IRONSIGHT_PATH=../IRONSIGHT
