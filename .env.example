# E*TRADE developer credentials (sandbox or production)
# Get keys at: https://developer.etrade.com/
ETRADE_CONSUMER_KEY=your_consumer_key_here
ETRADE_CONSUMER_SECRET=your_consumer_secret_here

# sandbox | production
ETRADE_ENV=sandbox

# Allow preview/place of option orders (set false to lock trading)
ETRADE_ENABLE_TRADING=true

# Optional preferred brokerage account when none is selected in the UI
# (visible account number OR opaque accountIdKey). Example Roth: 456138105
# ETRADE_ACCOUNT_ID=456138105

# Local API (avoid :3000 — often already in use)
PORT=3169

# IRONSIGHT (optional sibling clone; also avoid :3000)
IRONSIGHT_URL=http://localhost:3170
# Dev: relative to tradehole repo. Packaged .app: use an absolute path
# (install:mac rewrites this when sibling ../IRONSIGHT exists).
IRONSIGHT_PATH=../IRONSIGHT
# TRADEHOLE_IRONSIGHT_PATH=/Users/you/Documents/GitHub/IRONSIGHT
# Optional Node binary when Dock-launched .app has a minimal PATH
# TRADEHOLE_NODE_PATH=/opt/homebrew/bin/node

# Telegram: no API keys required for the live public-channel dump.
# Tradehole/OSINT pack calls IRONSIGHT /api/telegram?mode=dump&days=7&limit=100
# (paginated t.me/s/{channel} scrape). Private channels / forever-history would need
# optional GramJS (not wired): TELEGRAM_API_ID + TELEGRAM_API_HASH + session login.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_SESSION=

# Local news_reader (News tab) — Ollama summaries; Telegram web scrape only by default
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# NEWS_READER_DB=  # default: news_reader/news_reader.db
# TRADEHOLE_ROOT=  # override repo root if API not started from project dir

# Optional 5-Lock Ultimate Intel Alarm push (fires only on level transitions)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# PUSHOVER_TOKEN=your_pushover_app_token
# PUSHOVER_USER=your_pushover_user_key

# Optional override for SQLite history dir (default: ~/Library/Application Support/Tradehole)
# TRADEHOLE_DATA_DIR=/path/to/data

# Optional AISStream.io (Cyprus NAV-01 + Hormuz/Bab plot). Free key:
# Sign up at https://aisstream.io/ → API Keys → paste below.
# Subscribes to compact Cyprus + Hormuz strait + Bab el-Mandeb boxes.
# Cyprus navy-like still lights NAV-01 / High-go peer. Hormuz/Bab are
# plot-only (tankers/mil) — never Israel High-go.
# Community terrestrial AIS — warships often dark.
# KEY UNSET → Map shows KEY UNSET (deep links backup).
# AISSTREAM_API_KEY=

# DeepSeek free web-UI paste size cap (chars). Default 30000 (~7.5–10k tokens).
# Soft warn when paste hits this or is truncated (default max(maxChars, 35000)).
# DEEPSEEK_PASTE_MAX_CHARS=30000
# DEEPSEEK_PASTE_SOFT_WARN_CHARS=35000
